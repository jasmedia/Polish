<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: Polish reads and replaces text in other apps through the Accessibility API.
	     Hardened runtime is applied by scripts/bundle.sh (codesign with the runtime option). No network entitlement: the app is fully offline. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
